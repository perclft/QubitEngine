# QubitEngine Environment Configuration
# Copy this file to .env and customize for your deployment.

# --- Authentication ---
# Required for production. The scheduler will refuse to start without this
# unless QUBIT_ENGINE_SKIP_AUTH=1 is set.
QUBIT_ENGINE_AUTH_TOKEN=your-secret-token-here

# Set to "1" to disable auth (development only)
# QUBIT_ENGINE_SKIP_AUTH=1

# --- PostgreSQL ---
POSTGRES_USER=qubit
POSTGRES_PASSWORD=quantum
POSTGRES_DB=quantumcloud
DB_HOST=postgres
DB_PORT=5432
DB_USER=qubit
DB_PASS=quantum
DB_NAME=quantumcloud

# --- Redis ---
REDIS_ADDR=redis:6379

# --- Engine ---
# Force local backend (disables cloud offloading)
# QUBIT_FORCE_LOCAL=1

# MPS backend qubit threshold (default: 25)
# QUBIT_MPS_THRESHOLD=25

# Cloud backend URL (optional)
# QUBIT_CLOUD_URL=https://cloud.qubitengine.io

# Hardware topology file (optional)
# QUBIT_TOPOLOGY_PATH=/etc/qubit/topology.json

# --- OpenTelemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=qubit-engine
