# --- Stage 1: Builder (Glibc/Debian C++ Compilation) ---
FROM debian:bookworm-slim AS builder

ARG ENABLE_CUDA=OFF

# Install build tools and dynamic libraries
# Enable non-free for CUDA
RUN sed -i 's/Components: main/Components: main contrib non-free non-free-firmware/g' /etc/apt/sources.list.d/debian.sources
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git \
    libprotobuf-dev libgrpc-dev libgrpc++-dev protobuf-compiler-grpc \
    libssl-dev zlib1g-dev libc-ares-dev libgflags-dev libgoogle-glog-dev \
    pybind11-dev libcurl4-openssl-dev libgtest-dev \
    python3 python3-dev python3-pip \
    ca-certificates wget libstdc++6 zlib1g libssl3 \
    libopenmpi-dev openmpi-bin \
    libspdlog-dev libfmt-dev \
    libeigen3-dev nlohmann-json3-dev \
    && rm -rf /var/lib/apt/lists/*

# Build prometheus-cpp from source
RUN git clone -b v1.1.0 https://github.com/jupp0r/prometheus-cpp.git && \
    cd prometheus-cpp && \
    git submodule update --init && \
    cmake -B build \
    -DCMAKE_INSTALL_PREFIX=/usr/local \
    -DCMAKE_BUILD_TYPE=Release \
    -DENABLE_TESTING=OFF \
    -DBUILD_SHARED_LIBS=ON \
    . && \
    cmake --build build --parallel 4 && \
    cmake --install build && \
    cd .. && rm -rf prometheus-cpp

# Build hiredis from source
RUN git clone -b v1.2.0 https://github.com/redis/hiredis.git && \
    cd hiredis && \
    cmake -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr/local -DDISABLE_TESTS=ON . && \
    cmake --build build --parallel 4 && \
    cmake --install build && \
    cd .. && rm -rf hiredis

# Build redis-plus-plus from source
RUN git clone -b 1.3.10 https://github.com/sewenew/redis-plus-plus.git && \
    cd redis-plus-plus && \
    cmake -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr/local -DREDIS_PLUS_PLUS_BUILD_TEST=OFF -DREDIS_PLUS_PLUS_BUILD_SHARED=ON . && \
    cmake --build build --parallel 4 && \
    cmake --install build && \
    cd .. && rm -rf redis-plus-plus

# Install picojson (Required by jwt-cpp)
RUN wget https://raw.githubusercontent.com/kazuho/picojson/v1.3.0/picojson.h -O /usr/local/include/picojson.h

# Build jwt-cpp from source (Header-only, but provides CMake config)
RUN git clone -b v0.7.0 https://github.com/Thalhammer/jwt-cpp.git && \
    cd jwt-cpp && \
    cmake -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr/local -DJWT_CPP_BUILD_TESTS=OFF -DJWT_CPP_BUILD_EXAMPLES=OFF . && \
    cmake --install build && \
    cd .. && rm -rf jwt-cpp

# Build GTest
RUN cd /usr/src/gtest && \
    cmake . && \
    make && \
    cp lib/*.a /usr/lib

# Build rapidcheck from source
RUN git clone https://github.com/emil-e/rapidcheck.git && \
    cd rapidcheck && \
    cmake -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr/local -DRC_ENABLE_GTEST=ON -DRC_ENABLE_GMOCK=OFF . && \
    cmake --build build --parallel 4 && \
    cmake --install build && \
    cd .. && rm -rf rapidcheck


# Install Go (for generating stubs)
RUN GO_VERSION=1.23.1 && \
    wget https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz && \
    rm -rf /usr/local/go && \
    tar -C /usr/local -xzf go${GO_VERSION}.linux-amd64.tar.gz && \
    rm go${GO_VERSION}.linux-amd64.tar.gz
ENV PATH="/usr/local/go/bin:${PATH}"
WORKDIR /build

COPY api/ api/
COPY backend/ backend/

# DEBUG: Check if MPI files exist
RUN ls -R /usr/lib/x86_64-linux-gnu/openmpi/include || echo "MPI Dir Not Found"

# Cleanup potential artifacts from host
RUN rm -rf backend/build backend/CMakeCache.txt backend/CMakeFiles

# Compile
# Note: enable_language(CUDA) will find /usr/bin/nvcc from nvidia-cuda-toolkit
RUN cmake -B build -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_CXX_COMPILER=mpic++ \
    -DENABLE_CUDA=${ENABLE_CUDA} \
    -DMPI_ENABLED=ON \
    backend && \
    cmake --build build --target qubit_engine --config Release && \
    chmod +x /build/bin/qubit_engine

# --- Stage 2: Optimized Runtime ---
FROM debian:bookworm-slim

COPY --from=builder /build/bin/qubit_engine /usr/local/bin/qubit_engine
# COPY --from=builder /build/bin/tests /usr/local/bin/tests
# COPY --from=builder /build/bin/benchmark /usr/local/bin/benchmark
# Copy installed libs
COPY --from=builder /usr/local/lib/libhiredis* /usr/local/lib/
COPY --from=builder /usr/local/lib/libredis++* /usr/local/lib/
COPY --from=builder /usr/local/lib/libprometheus-cpp* /usr/local/lib/
COPY --from=builder /build/bin/libqubit_engine_core.so /usr/local/lib/
COPY --from=builder /build/bin/libqubit_engine_proto.so /usr/local/lib/
RUN ldconfig
# Also copy nvidia-ml and other potentially needed libs if they are dynamic
# But for now libcudart is the main one linked.

# Install runtime libs
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    libstdc++6 libgrpc++1.51 libprotobuf32 libssl3 zlib1g libc-ares2 \
    libgflags2.2 libgoogle-glog0v6 \
    libopenmpi3 openmpi-bin libgomp1 \
    libspdlog1.10 libfmt9 \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

EXPOSE 50051

# --- SECURITY HARDENING STARTS HERE ---
# 1. Create a non-root user 'qubit'
RUN useradd -m -u 1000 -s /bin/bash qubit
# 2. Assign ownership
RUN chown qubit:qubit /usr/local/bin/qubit_engine
# 3. Switch context (Drop Root)
USER qubit
# --------------------------------------

ENTRYPOINT ["/usr/local/bin/qubit_engine"]
